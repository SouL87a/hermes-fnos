appname               = hermes
version               = 0.1.0
display_name          = Hermes Agent
desc                  = Nous Research 开源的自我进化 AI Agent。飞牛原生打包版（非 Docker）：服务端跑在 NAS 上，浏览器 / 飞牛桌面直接用完整控制台——配置、API Key、会话管理、内嵌终端；数据保存在 NAS 上，全设备共用一份。支持飞牛统一网关入口，也可用 http://NAS地址:9119 局域网直连（面板密码鉴权）。安装时从上游获取源码与依赖（需联网，支持代理），之后可用应用内 update 跟随官方更新。
platform              = x86
source                = thirdparty
developer             = Nous Research
developer_url         = https://github.com/NousResearch/hermes-agent
maintainer            = soul87
maintainer_url        = https://github.com/SouL87a/hermes-fnos
distributor           = soul87
distributor_url       = https://github.com/SouL87a/hermes-fnos
license               = MIT
desktop_uidir         = ui
desktop_applaunchname = hermes.Application
gatewayPrefix         = /app/hermes
gatewaySocket         = hermes.sock
service_port          = 9119
checkport             = true
ctl_stop              = true
install_dep_apps      = nodejs_v24
changelog             = 改为与官方一致的安装方式：安装时拉取上游源码并由 Hermes 自带的包管理器创建虚拟环境，不再预置运行时，也不再需要为本包打补丁；源码保留 .git，支持应用内 hermes update 跟随官方版本。
