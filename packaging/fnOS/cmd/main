#!/bin/bash

### Hermes Agent —— 飞牛 fnOS 服务生命周期
###
### 原生应用，两种运行时模式（构建时定）：
###  - 自带 CPython 模式（默认）：依赖预装进包内 python-build-standalone 的
###    site-packages，运行期零联网；不用 venv（venv 的 pyvenv.cfg/符号链接带构建机
###    绝对路径，装到 NAS 后路径变化会失效）。自带 SQLite 较新，WAL 正常。
###  - 系统 Python 模式：安装时在 NAS 上建 venv（${TRIM_PKGVAR}/venv），
###    解释器取自应用中心「Python 3.12」，依赖装进该 venv。（系统 libsqlite3 偏旧
###    → WAL 会被 Hermes 降级成 DELETE，doctor 报假 FTS 损坏，故不作默认。）
### 两种模式都不需要在运行期 pip；web_dist 已预构建（--skip-build）。
### 形态：hermes dashboard（FastAPI+uvicorn，仅绑 127.0.0.1）+
###        gateway-proxy.py（监听 Unix Socket，反代到回环端口）。
### 前端是 React Router SPA，原生支持路径前缀反代：代理只要发
### X-Forwarded-Prefix: /app/hermes，服务端就改写 index.html 的资产 URL
### 并注入 window.__HERMES_BASE_PATH__，所以代理层无需改写 HTML。
###
### ⚠ 应用/依赖可能装在任意存储空间（/vol1、/vol2、…）。所有路径从
### TRIM_APPDEST 推导，绝不写死卷号。
###
### status 约定：运行中 exit 0，未运行 exit 3（不是 1）。

APP="hermes"
MODULE="hermes_cli.main"
PORT="${TRIM_SERVICE_PORT:-9119}"
GATEWAY_PREFIX="/app/hermes"

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

### TRIM_APPDEST 兜底：必须落到 target 链接指向的真目录。
### /var/apps/<app> 本身是真目录，readlink -f 不穿透它 —— 拿它当 APPDEST 会拼出
### 不存在的路径，status/stop 会静默失效。
if [ -z "${TRIM_APPDEST}" ]; then
    if [ -d "/var/apps/${APP}/target" ]; then
        TRIM_APPDEST="$(readlink -f "/var/apps/${APP}/target")"
    else
        TRIM_APPDEST="$(readlink -f "/var/apps/${APP}")"
    fi
fi
: "${TRIM_PKGVAR:=/var/apps/${APP}/var}"
: "${TRIM_USERNAME:=${APP}}"
: "${TRIM_GROUPNAME:=${TRIM_USERNAME}}"

APP_DIR="${TRIM_APPDEST}"
SRC_DIR="${APP_DIR}/runtime/hermes"

### 本脚本的绝对路径 / 所在目录。
### ⚠ cmd/ 被 fnOS 装在 /var/apps/<app>/cmd/（= <appdata>/cmd），**不在**
### 应用内容树 APP_DIR（= /vol1/@appcenter/<app>）里 —— 任何 `${APP_DIR}/cmd/main`
### 都是错的路径。凡是需要引用本脚本自身的地方，一律用下面这两个变量。
SELF_PATH="$(readlink -f "$0" 2>/dev/null || echo "$0")"
APP_CTL_DIR="$(cd "$(dirname "${SELF_PATH}")" && pwd)"
### 两种运行时模式（由构建时的标记文件决定）：
###  - 自带 CPython（默认）：PY=runtime/python/bin/python3，依赖在其 site-packages。
###  - 系统 Python 模式：存在 .use-system-python 标记时用 NAS 上现建的
###    venv（${TRIM_PKGVAR}/venv，路径是本机的、可移植性没问题）。
if [ -f "${APP_DIR}/runtime/.use-system-python" ]; then
    PY="${TRIM_PKGVAR}/venv/bin/python3"
else
    PY="${APP_DIR}/runtime/python/bin/python3"
fi
WEB_DIST="${APP_DIR}/runtime/web_dist"
GATEWAY_SOCKET="${APP_DIR}/hermes.sock"
GATEWAY_PROXY="${APP_DIR}/gateway-proxy.py"
DATA_DIR="${TRIM_PKGVAR}"
### 可选依赖的懒安装目标（TTS/STT/Bedrock 等首次使用时才装）。
### 为什么必须显式给：自带 CPython 不是 venv，而 Hermes 的懒安装默认走
### `uv pip install`（uv 无 venv 时会拒绝："No virtual environment found"），
### 且它会强制设 VIRTUAL_ENV=<解释器上级>，连 UV_SYSTEM_PYTHON 都压不住、还会
### 试图写只读的 TRIM_APPDEST（实测均失败）。设了这个变量后，上游改走
### `uv pip install --target <此目录>`（上游明确为"非 venv 部署"设计，带 ABI 戳
### 校验）—— 不需要 venv，且落在可写的数据目录。实测 --target 路径 exit=0。
LAZY_SITE="${DATA_DIR}/site-packages"

### 进程识别：绝对路径匹配，不误伤其他 python。
### ⚠ 系统 Python 模式下 dashboard 的 argv[0] 是 ${TRIM_PKGVAR}/venv/bin/python3，
### 【不含】${APP_DIR}/runtime（实测该进程 cmdline 只有 venv 解释器 + 参数）。
### 沿用旧 pattern 会让 pid_alive()/status() 恒判「未运行」：应用中心显示已停止 /
### 启动失败，而 start 会重复拉起（端口冲突），stop 的兜底 pkill 也失效。
### 改用「解释器 + 模块」前缀，两种运行时模式都精确命中。
PATTERN="${PY} -m ${MODULE}"
GATEWAY_PATTERN="${APP_DIR}/gateway-proxy.py"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

### 进程存活判定以 /proc 为准。
### 不用 kill -0：非属主调用时它对活着的进程返回 EPERM，与"不存在"无法区分，
### 会把 pidfile 误删（而 pidfile 是 fnOS 判定服务状态的依据）。
pid_alive() {
    local pid="$1" cmd state
    [ -n "${pid}" ] || return 1
    [ -d "/proc/${pid}" ] || return 1
    state="$(cut -d' ' -f3 "/proc/${pid}/stat" 2>/dev/null)"
    [ "${state}" = "Z" ] && return 1
    cmd="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null)"
    [ -z "${cmd}" ] && return 0
    case "${cmd}" in *"${PATTERN}"*|*"${GATEWAY_PATTERN}"*) return 0 ;; esac
    return 1
}

### 只认本应用自己的进程（绝对路径匹配）。
### pgrep/pkill 的 pattern 前必须加 --，否则会被 procps 当成选项。
own_pids() {
    pgrep -f -- "${PATTERN}" 2>/dev/null
    pgrep -f -- "${GATEWAY_PATTERN}" 2>/dev/null
}

read_pid() {
    [ -r "${PID_FILE}" ] && head -n 1 "${PID_FILE}" | tr -d '[:space:]'
}

### 工作区：优先 TRIM_DATA_SHARE_PATHS 里名为 hermes/workspace 的共享目录，
### 否则第一个共享路径，最终兜底 PKGVAR/workspace。
resolve_workspace() {
    local p
    if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
        local IFS=':'
        for p in ${TRIM_DATA_SHARE_PATHS}; do
            case "${p}" in */hermes/workspace) printf '%s' "${p}"; return 0 ;; esac
        done
        for p in ${TRIM_DATA_SHARE_PATHS}; do
            [ -n "${p}" ] && { printf '%s' "${p}"; return 0; }
        done
    fi
    printf '%s' "${TRIM_PKGVAR}/workspace"
}

port_listening() {
    grep -q ":$(printf '%04X' "${PORT}")" /proc/net/tcp 2>/dev/null
}

### 查找 node —— 对话页的 TUI 终端需要它。
### 为什么必须显式给：上游找 node 时优先读 $HERMES_NODE；未设时它会走自己的运行时
### 定位路径，在离线/受限环境会**长时间无输出**（实测报告缺陷 4）。应用中心装了
### nodejs_v22 就有可用 node，直接指过去最稳。
find_node_bin() {
    local d
    # 优先应用中心的 nodejs（v22/v24），跨卷兜底
    for d in /var/apps/nodejs_v22/target/bin/node /var/apps/nodejs_v22/bin/node \
             /var/apps/nodejs_v24/target/bin/node /var/apps/nodejs_v24/bin/node; do
        [ -x "${d}" ] && { printf '%s' "${d}"; return 0; }
    done
    d="$(command -v node 2>/dev/null)" && [ -x "${d}" ] && { printf '%s' "${d}"; return 0; }
    for d in /vol*/@appcenter/nodejs_v*/bin/node; do
        [ -x "${d}" ] && { printf '%s' "${d}"; return 0; }
    done
    return 1
}

### 面板入口说明（写给排查的人）：
### ui/config 的入口是 /app/hermes（iframe）。飞牛统一网关把 /app/hermes/**
### 转到 hermes.sock 且不剥前缀。gateway-proxy.py 剥掉前缀后转发到
### 127.0.0.1:PORT，并给上游发 X-Forwarded-Prefix，让 dashboard 生成带前缀的
### 资产 URL 与 __HERMES_BASE_PATH__。鉴权：dashboard 绑回环 → 不做 auth 门，
### 网关侧用飞牛登录态（X-Trim-*）。

GATEWAY_PID_FILE="${TRIM_PKGVAR}/gateway.pid"
GATEWAY_WANT_FILE="${TRIM_PKGVAR}/gateway.want"   # 存在=期望运行；删除=停止

### 消息网关 supervisor。
### 为什么需要：dashboard 的「重启网关」会把 gateway 进程退出、指望外部 manager
### 重新拉起（--external-supervisor 的语义就是"退出后交还给 manager"）。fnOS 没有
### systemd/s6 那样自带的 manager，所以本脚本充当 supervisor：want 文件在 → 退出就拉起。
### 官方 trim.hermes 用 Go wrapper 做同样的事。
###
### gateway_want 存在 → 持续拉起；被删除 → 循环退出（用于正常停止）。
gateway_supervisor_loop() {
    local ws="$1"
    ### node_env 不靠参数传递：runuser 分支只传了 ws，参数化会在那条路径上丢失
    ### HERMES_NODE。循环体自行解析（见 find_node_bin 的说明）。
    local node_env="" _nb
    if _nb="$(find_node_bin)"; then node_env="HERMES_NODE='${_nb}' \\"; fi
    ### 退出时带走自己 spawn 的 gateway 子进程。
    ### 为什么必须：单例保护 / stop 会 kill 掉本 supervisor，但若它正卡在 `wait`，
    ### 那个 gateway 会成孤儿、继续占着 profile → 新 supervisor 拉的 gateway 永远
    ### exit 75。让 supervisor 自清子进程，kill 掉 supervisor 即等于 kill 掉它的 gateway。
    local gwpid=""
    _gw_cleanup() { [ -n "${gwpid}" ] && kill -TERM "${gwpid}" 2>/dev/null || true; }
    trap '_gw_cleanup; exit 0' TERM INT

    local GW_CMD
    GW_CMD="cd '${SRC_DIR}' && exec env \
HOME='${DATA_DIR}' \
PYTHONPATH='${SRC_DIR}:${LAZY_SITE}' \
PYTHONUNBUFFERED=1 \
PYTHONDONTWRITEBYTECODE=1 \
HERMES_HOME='${DATA_DIR}' \
HERMES_BUNDLED_SKILLS='${SRC_DIR}/skills' \
HERMES_OPTIONAL_SKILLS='${SRC_DIR}/optional-skills' \
HERMES_BUNDLED_PLUGINS='${SRC_DIR}/plugins' \
HERMES_BUNDLED_LOCALES='${SRC_DIR}/locales' \
HERMES_OPTIONAL_MCPS='${SRC_DIR}/optional-mcps' \
HERMES_WRITE_SAFE_ROOT='${ws}' \
HERMES_MANAGED_BY='trim-hermes-fnos' \
HERMES_LAZY_INSTALL_TARGET='${LAZY_SITE}' \
HERMES_TUI_WS_ORPHAN_REAP_GRACE_S='300' \
${node_env}
'${PY}' -m ${MODULE} gateway run --external-supervisor"

    ### 退避：上游用 exit 75 表示"已有实例在服务同一 profile，请 manager 稍后重试"
    ### （gateway/restart.py 的 GATEWAY_SERVICE_RESTART_EXIT_CODE）。若本 supervisor
    ### 因任何原因变成非唯一（历史上就出现过双 supervisor），固定 1s 重试会把它放大成
    ### 每秒级重启风暴。按退出码退避：75/0 走指数退避，其余（真崩溃）保持 1s 快速自愈。
    local backoff=1
    while [ -f "${GATEWAY_WANT_FILE}" ]; do
        log_msg "supervisor: 启动 gateway"
        if [ "$(id -un)" = "${TRIM_USERNAME}" ]; then
            bash -c "${GW_CMD}" >> "${LOG_FILE}" 2>&1 &
        else
            runuser -u "${TRIM_USERNAME}" -- bash -c "${GW_CMD}" >> "${LOG_FILE}" 2>&1 &
        fi
        gwpid=$!   # 赋给外层变量，trap 才能看到（不要用 local，否则脱离 trap 作用域）
        printf '%s' "${gwpid}" > "${GATEWAY_PID_FILE}"
        local started_at; started_at="$(date +%s)"
        wait "${gwpid}" 2>/dev/null
        local rc=$?
        # 被主动停止（want 文件已删）→ 退出循环
        [ -f "${GATEWAY_WANT_FILE}" ] || break
        # 稳定跑满 60s 后复位退避（说明上次是偶发，不是持续冲突）
        [ $(( $(date +%s) - started_at )) -ge 60 ] && backoff=1
        case "${rc}" in
            75|0)
                # 已有实例在服务同一 profile / 抢单例失败 → 退避重试
                log_msg "supervisor: gateway 退出 (code=${rc})，${backoff}s 后重试"
                sleep "${backoff}"
                backoff=$(( backoff < 30 ? backoff * 2 : 30 )) ;;
            *)
                log_msg "supervisor: gateway 退出 (code=${rc})，1s 后重启"
                sleep 1 ;;
        esac
    done
    rm -f "${GATEWAY_PID_FILE}"
    log_msg "supervisor: 退出"
}

### 列出所有 supervisor 循环体的 PID（去重），**排除自身与父进程**。
### 覆盖两种 cmdline 形态：
###  - 新版：exec 后的 `${SELF_PATH} __gateway_supervisor <ws>`
###  - 旧版：以应用用户运行时 `gateway_supervisor_loop ... &` 只 fork 不 exec，
###    子 shell 沿用调用者 cmdline（`cmd/main gateway-restart` / `gateway-start`）→
###    必须按这些子命令匹配，否则 stop / 单例清理都杀不掉它，故障无法自愈（缺陷 B）。
### ⚠ 排除自身：本函数会被 `restart_gateway`（自身 cmdline = `cmd/main gateway-restart`）
###   调用，按该 pattern 匹配会把自己也算进去 → 自检误报 / pkill 自杀。
supervisor_pids() {
    local pat pid
    for pat in \
        "${SELF_PATH} __gateway_supervisor" \
        "cmd/main __gateway_supervisor" \
        "${SELF_PATH} gateway-restart" \
        "${SELF_PATH} gateway-start" \
        "cmd/main gateway-restart" \
        "cmd/main gateway-start"; do
        for pid in $(pgrep -f -- "${pat}" 2>/dev/null); do
            [ "${pid}" = "$$" ] && continue
            [ "${pid}" = "${PPID}" ] && continue
            printf '%s\n' "${pid}"
        done
    done | sort -u
}

kill_supervisors() {
    local pid
    for pid in $(supervisor_pids); do
        kill -"${1:-TERM}" "${pid}" 2>/dev/null || true
    done
}

start_gateway_supervisor() {
    local ws="$1"

    ### 单例保护（缺陷 A）：本函数"调用即新建"，而 gateway-restart 会被面板连点 /
    ### 前端超时重试触发多次 → 起出多份 supervisor → 各拉一个 gateway 抢单例 →
    ### 后起者必 exit 75 → 无限重启风暴。所以起之前先清掉已有实例。
    ### ⚠ 清理必须放在写 want 文件【之前】：否则旧 supervisor 正卡在 `wait` 时若看到
    ###   want 复活，会再拉一个 gateway（虽随后被我们杀掉，但那个 gateway 会成孤儿）。
    if [ -n "$(supervisor_pids)" ]; then
        log_msg "supervisor 已在运行，先清理旧实例再重启"
        kill_supervisors TERM
        sleep 1
        kill_supervisors KILL
    fi
    : > "${GATEWAY_WANT_FILE}"

    ### 两个分支都必须 exec：fork 的子 shell 会沿用调用者 cmdline，stop 的兜底
    ### pkill 匹配不到（缺陷 B），且 pgrep 单例检查也会误判。exec 后 cmdline 稳定为
    ### `${SELF_PATH} __gateway_supervisor <ws>`，可被精确命中。
    ### ⚠ `200>&-` 必须加：调用方（restart_gateway）持有 flock fd 200，fork 出的子进程
    ###   会继承该 fd → 长命的 supervisor 会一直持有锁 → 之后每次 gateway-restart 都
    ###   拿不到锁、静默 no-op（网关再也重启不了）。子进程主动关闭该 fd 即释放锁。
    if [ "$(id -un)" = "${TRIM_USERNAME}" ]; then
        bash -c "exec '${SELF_PATH}' __gateway_supervisor '${ws}'" >> "${LOG_FILE}" 2>&1 200>&- &
    else
        runuser -u "${TRIM_USERNAME}" -- bash -c \
            "exec '${SELF_PATH}' __gateway_supervisor '${ws}'" >> "${LOG_FILE}" 2>&1 200>&- &
    fi
    log_msg "启动消息网关 supervisor (pid=$!)"
}

start_process() {
    if status > /dev/null 2>&1; then
        return 0
    fi

    if [ ! -x "${PY}" ]; then
        log_msg "启动失败：找不到 ${PY}"
        echo "应用文件缺失：${PY}" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    if [ ! -d "${SRC_DIR}/hermes_cli" ]; then
        log_msg "启动失败：找不到源码树 ${SRC_DIR}/hermes_cli"
        echo "应用文件缺失：${SRC_DIR}" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    if [ ! -f "${WEB_DIST}/index.html" ]; then
        log_msg "启动失败：缺少预构建前端 ${WEB_DIST}/index.html"
        echo "应用缺少预构建前端（web_dist）" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi

    local ws
    ws="$(resolve_workspace)"
    mkdir -p "${DATA_DIR}" "${DATA_DIR}/log" "${ws}" "${LAZY_SITE}" "$(dirname "${PID_FILE}")"
    rm -f "${GATEWAY_SOCKET}"

    log_msg "Starting Hermes dashboard (gateway + loopback port) ..."
    log_msg "PY=${PY}  APP_DIR=${APP_DIR}  HOME=${DATA_DIR}  WS=${ws}  PORT=${PORT}  SOCK=${GATEWAY_SOCKET}"

    # 主服务：dashboard 仅绑回环，避免触发非回环的强制鉴权门。
    # 资源定位用上游官方的 HERMES_BUNDLED_* 机制（比靠 PROJECT_ROOT 推导更稳，
    # 与官方 fnOS 包的 hermes-env 一致）：源码树即资源根。
    # TUI 终端用的 node：显式给出，避免上游自己找 node 时长时间无输出
    local NODE_BIN NODE_ENV=""
    if NODE_BIN="$(find_node_bin)"; then
        NODE_ENV="HERMES_NODE='${NODE_BIN}' \\"
        log_msg "TUI node: ${NODE_BIN}"
    else
        log_msg "警告：未找到 node —— 对话页终端将不可用（请在应用中心安装 Node.js）"
    fi

    local CMD
    CMD="cd '${SRC_DIR}' && exec env \
HOME='${DATA_DIR}' \
PYTHONPATH='${SRC_DIR}:${LAZY_SITE}' \
PYTHONUNBUFFERED=1 \
PYTHONDONTWRITEBYTECODE=1 \
HERMES_HOME='${DATA_DIR}' \
HERMES_BUNDLED_SKILLS='${SRC_DIR}/skills' \
HERMES_OPTIONAL_SKILLS='${SRC_DIR}/optional-skills' \
HERMES_BUNDLED_PLUGINS='${SRC_DIR}/plugins' \
HERMES_BUNDLED_LOCALES='${SRC_DIR}/locales' \
HERMES_OPTIONAL_MCPS='${SRC_DIR}/optional-mcps' \
HERMES_WEB_DIST='${WEB_DIST}' \
HERMES_WRITE_SAFE_ROOT='${ws}' \
HERMES_MANAGED_BY='trim-hermes-fnos' \
HERMES_LAZY_INSTALL_TARGET='${LAZY_SITE}' \
HERMES_TUI_WS_ORPHAN_REAP_GRACE_S='300' \
${NODE_ENV}
'${PY}' -m ${MODULE} dashboard --host 127.0.0.1 --port '${PORT}' --no-open --skip-build"

    if [ "$(id -un)" = "${TRIM_USERNAME}" ]; then
        bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    else
        runuser -u "${TRIM_USERNAME}" -- bash -c "${CMD}" >> "${LOG_FILE}" 2>&1 &
    fi
    printf "%s" "$!" > "${PID_FILE}"

    # 网关代理：Unix Socket → 127.0.0.1:PORT，剥前缀 + 发 X-Forwarded-Prefix。
    if [ ! -f "${GATEWAY_PROXY}" ]; then
        log_msg "启动失败：找不到 ${GATEWAY_PROXY}"
        echo "缺少 gateway-proxy.py" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    local GW_CMD
    # HERMES_GATEWAY_DEBUG=1：把每个请求的路径与客户端 X-Forwarded-* 记进日志，
    # 以及 HTML 改写结果。真机排查资源 404 时这是唯一的现场证据。
    # 输出量很小（每请求一行），长期开启无妨。
    GW_CMD="exec env \
HERMES_APP_ROOT='${APP_DIR}' \
HERMES_CMD_MAIN='${SELF_PATH}' \
HERMES_APP_CTL_DIR='${APP_CTL_DIR}' \
HERMES_GATEWAY_SOCKET='${GATEWAY_SOCKET}' \
HERMES_GATEWAY_PREFIX='${GATEWAY_PREFIX}' \
HERMES_UPSTREAM_HOST='127.0.0.1' \
HERMES_UPSTREAM_PORT='${PORT}' \
HERMES_GATEWAY_DEBUG='1' \
'${PY}' '${GATEWAY_PROXY}'"
    if [ "$(id -un)" = "${TRIM_USERNAME}" ]; then
        bash -c "${GW_CMD}" >> "${LOG_FILE}" 2>&1 &
    else
        runuser -u "${TRIM_USERNAME}" -- bash -c "${GW_CMD}" >> "${LOG_FILE}" 2>&1 &
    fi

    # 消息网关（Telegram / QQ / 飞书等）—— 缺陷 5：官方 trim.hermes 会起它，
    # 本包原先漏了，导致「Gateway Status: Stopped」，消息平台开箱不可用。
    #
    # 由本脚本当 supervisor（--external-supervisor 的语义就是"退出后交还给
    # manager 重启"）：gateway 退出就拉起，这样 dashboard 的「重启网关」才有意义
    # （见下面 supervisor 循环）。
    start_gateway_supervisor "${ws}"

    # 就绪：TCP 回环监听 + Unix Socket
    local i=0
    while [ "${i}" -lt 90 ]; do
        if port_listening && [ -S "${GATEWAY_SOCKET}" ]; then
            log_msg "started, port ${PORT} + socket ${GATEWAY_SOCKET} (PID=$(cat "${PID_FILE}" 2>/dev/null))"
            return 0
        fi
        pid_alive "$(read_pid)" || { log_msg "警告：Hermes 进程提前退出，详见日志"; return 1; }
        sleep 1
        i=$((i + 1))
    done
    if pid_alive "$(read_pid)" && [ -S "${GATEWAY_SOCKET}" ]; then
        log_msg "started (slow), socket ready"
        return 0
    fi
    if pid_alive "$(read_pid)"; then
        log_msg "警告：端口/socket 暂未就绪但进程存活，交由应用中心继续探测"
        return 0
    fi
    log_msg "警告：进程已退出且未就绪，请查看应用日志"
    return 1
}

stop_process() {
    log_msg "Stopping process ..."

    local pid
    pid="$(read_pid)"
    if [ -n "${pid}" ]; then
        if pid_alive "${pid}"; then
            log_msg "send TERM signal to PID:${pid} ..."
            kill -TERM "${pid}" 2>/dev/null || true
            local count=0
            while pid_alive "${pid}" && [ "${count}" -lt 12 ]; do
                sleep 1
                count=$((count + 1))
            done
            if pid_alive "${pid}"; then
                log_msg "send KILL signal to PID:${pid} ..."
                kill -KILL "${pid}" 2>/dev/null || true
            fi
        else
            log_msg "pid ${pid} 已不存在"
        fi
        rm -f "${PID_FILE}"
    fi

    # 先停 gateway supervisor：删 want 文件 → 它不再拉起 gateway，循环自然退出。
    # 必须在清理进程之前做，否则 supervisor 会把我们刚杀掉的 gateway 又拉起来。
    rm -f "${GATEWAY_WANT_FILE}"
    rm -f "${GATEWAY_PID_FILE}"

    # 兜底：dashboard 会 spawn 子进程（pty/session reaper），runuser 包装导致
    # pidfile 记的是 wrapper 的 PID，所以按绝对路径 pattern 兜底清理。
    if own_pids > /dev/null 2>&1; then
        log_msg "清理残留进程 (${PATTERN} / ${GATEWAY_PATTERN})"
        pkill -TERM -f -- "${PATTERN}" 2>/dev/null || true
        pkill -TERM -f -- "${GATEWAY_PATTERN}" 2>/dev/null || true
        sleep 1
        pkill -KILL -f -- "${PATTERN}" 2>/dev/null || true
        pkill -KILL -f -- "${GATEWAY_PATTERN}" 2>/dev/null || true
    fi
    # supervisor 循环体本身（bash 跑 gateway_supervisor_loop）也按 cmd/main 路径兜底。
    # kill_supervisors 同时覆盖 exec 形态与历史遗留的 fork 子 shell（缺陷 B）。
    kill_supervisors
    sleep 1
    kill_supervisors   # 二次确保 fork 子 shell 也被清掉
    rm -f "${GATEWAY_SOCKET}"

    log_msg "process stopped"
    return 0
}

status() {
    local pid
    pid="$(read_pid)"
    if [ -n "${pid}" ] && pid_alive "${pid}"; then
        return 0
    fi
    # pidfile 所指进程确实不存在才清理；权限受限（读不到 cmdline）一律留着
    if [ -n "${pid}" ] && [ ! -d "/proc/${pid}" ]; then
        rm -f "${PID_FILE}"
    fi
    # pidfile 丢了但进程还在（异常重启后常见）——重新认领，避免 stop 失效
    pid="$(own_pids | head -n 1)"
    if [ -n "${pid}" ] && pid_alive "${pid}"; then
        printf "%s" "${pid}" > "${PID_FILE}" 2>/dev/null || true
        return 0
    fi
    return 1
}

### 在线更新：调 hermes-update.py（用同一个自带 Python）。
### 用法：main update {check|apply|status|version}
do_update() {
    local script="${APP_DIR}/hermes-update.py"
    if [ ! -f "${script}" ]; then
        echo "缺少更新脚本：${script}" >&2
        return 1
    fi
    if [ ! -x "${PY}" ]; then
        echo "运行时不可用：${PY}" >&2
        return 1
    fi
    HERMES_APP_ROOT="${APP_DIR}" HERMES_DATA_ROOT="${DATA_DIR}" \
        "${PY}" "${script}" "${1:-status}"
}

### 单独重启消息网关（供代理的重启端点调用）：
### 删 want 文件让 supervisor 循环退出，再写回 want 文件 + 杀掉当前 gateway，
### supervisor 会自动拉起新的。不动 dashboard / 代理。
### 防重入锁（缺陷 E）：gateway-{restart,start,stop} 全程无锁、restart 耗时可达
### 15s+，面板连点或前端超时重试会并发进入 → 起出多份 supervisor。flock 串行化。
### ⚠ 无 flock 时退化为"无锁"而非"直接返回"：否则漏装 util-linux 的机器上整个
### 操作会变成静默 no-op。每次调用是独立进程，复用同一个 fd 200 没问题。
acquire_gateway_lock() {
    command -v flock > /dev/null 2>&1 || return 0
    mkdir -p "${TRIM_PKGVAR}"
    exec 200>"${TRIM_PKGVAR}/gateway-restart.lock" || return 0
    flock -n 200 || return 1
    return 0
}

restart_gateway() {
    acquire_gateway_lock || { log_msg "gateway-restart 已在执行中，忽略本次重复调用"; return 0; }

    local ws
    ws="$(resolve_workspace)"

    # 停：删 want → 杀 gateway → 等 supervisor 退出。
    # node_env 不再在这里算：supervisor 循环体自行解析 HERMES_NODE（修缺陷 D）。
    rm -f "${GATEWAY_WANT_FILE}"
    local gpid
    gpid="$(head -n 1 "${GATEWAY_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    [ -n "${gpid}" ] && kill -TERM "${gpid}" 2>/dev/null || true
    pkill -TERM -f -- "${PATTERN} gateway run" 2>/dev/null || true
    local i=0
    while [ "${i}" -lt 15 ]; do
        pgrep -f -- "${PATTERN} gateway run" > /dev/null 2>&1 || break
        sleep 1
        i=$((i + 1))
    done
    pkill -KILL -f -- "${PATTERN} gateway run" 2>/dev/null || true

    # 起：写回 want → 重启 supervisor（start_gateway_supervisor 自带单例清理）
    start_gateway_supervisor "${ws}"
    log_msg "gateway restart 完成"
    return 0
}

### 仅启动消息网关（不停 dashboard / 代理）。供代理的 /api/gateway/start 调用。
start_gateway_only() {
    acquire_gateway_lock || { log_msg "gateway 操作已在执行中，忽略本次 start"; return 0; }
    local ws
    ws="$(resolve_workspace)"
    if [ -f "${GATEWAY_WANT_FILE}" ] && pgrep -f -- "${PATTERN} gateway run" > /dev/null 2>&1; then
        log_msg "gateway 已在运行"
        return 0
    fi
    start_gateway_supervisor "${ws}"
    log_msg "gateway start 完成"
    return 0
}

### 仅停止消息网关（不停 dashboard / 代理）。供代理的 /api/gateway/stop 调用。
stop_gateway_only() {
    acquire_gateway_lock || { log_msg "gateway 操作已在执行中，忽略本次 stop"; return 0; }
    rm -f "${GATEWAY_WANT_FILE}"
    local gpid
    gpid="$(head -n 1 "${GATEWAY_PID_FILE}" 2>/dev/null | tr -d '[:space:]')"
    [ -n "${gpid}" ] && kill -TERM "${gpid}" 2>/dev/null || true
    pkill -TERM -f -- "${PATTERN} gateway run" 2>/dev/null || true
    local i=0
    while [ "${i}" -lt 15 ]; do
        pgrep -f -- "${PATTERN} gateway run" > /dev/null 2>&1 || break
        sleep 1
        i=$((i + 1))
    done
    pkill -KILL -f -- "${PATTERN} gateway run" 2>/dev/null || true
    # 显式清 supervisor：want 已删、gateway 已杀，它没有需要优雅清理的东西；
    # 且它可能正卡在退避 sleep（TERM 的 trap 要等 sleep 结束才跑，最长 30s）→ 用 KILL 立即生效。
    kill_supervisors KILL
    rm -f "${GATEWAY_PID_FILE}"
    log_msg "gateway stop 完成"
    return 0
}

case "$1" in
    start)   start_process ;;
    stop)    stop_process ;;
    restart) stop_process; sleep 1; start_process ;;
    status)  if status; then exit 0; else exit 3; fi ;;
    update)  shift; do_update "${1:-status}" ;;
    gateway-restart) restart_gateway ;;
    gateway-start)   start_gateway_only ;;
    gateway-stop)    stop_gateway_only ;;
    # 内部：被 runuser 以应用用户身份拉起的 supervisor 循环体
    __gateway_supervisor) shift; gateway_supervisor_loop "$@" ;;
    *)       exit 1 ;;
esac
