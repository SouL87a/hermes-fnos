#!/bin/bash
# 升级后：补执行位；从旧布局升级时做一次性迁移。
###
### 布局变更（v0.23 起）：
###   旧：包内预置 runtime/python + runtime/hermes（扁平依赖）+ hermes-git.git
###   新：源码在 <data>/src（git clone，带 .git），依赖在 PM 真实 venv
### 从旧版升级上来时，旧的预置运行时不再被使用；用户数据必须原样保留。
set -e

APP="hermes"
if [ -z "${TRIM_APPDEST}" ]; then
    if [ -d "/var/apps/${APP}/target" ]; then
        TRIM_APPDEST="$(readlink -f "/var/apps/${APP}/target")"
    else
        TRIM_APPDEST="$(readlink -f "/var/apps/${APP}")"
    fi
fi
export TRIM_APPDEST
export TRIM_PKGVAR="${TRIM_PKGVAR:-/var/apps/${APP}/var}"
export TRIM_USERNAME="${TRIM_USERNAME:-${APP}}"
export TRIM_GROUPNAME="${TRIM_GROUPNAME:-${TRIM_USERNAME}}"

### 自证日志 + 失败留痕（见 upgrade_init 的说明）。
mkdir -p "${TRIM_PKGVAR}/log" 2>/dev/null || true
_hermes_err_trap() {
    local rc=$? line=$1 cmd=$2
    local msg="[upgrade_callback] 第 ${line} 行失败 (rc=${rc}): ${cmd}"
    echo "${msg}" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
    echo "$(date -Is) ${msg}" >> "${TRIM_PKGVAR}/log/upgrade.log" 2>/dev/null || true
}
trap '_hermes_err_trap ${LINENO} "${BASH_COMMAND}"' ERR

RUNTIME="${TRIM_APPDEST}/runtime"
DATA="${TRIM_PKGVAR}"
echo "$(date -Is) upgrade_callback 开始：APP=${TRIM_APPDEST} DATA=${DATA}" \
    >> "${DATA}/log/upgrade.log" 2>/dev/null || true

### 1) 执行位（fnpack 会把 app.tgz 内权限拍平）
[ -f "${TRIM_APPDEST}/gateway-proxy.py" ] && chmod +x "${TRIM_APPDEST}/gateway-proxy.py" 2>/dev/null || true
[ -f "${TRIM_APPDEST}/scripts/install-runtime.sh" ] && chmod +x "${TRIM_APPDEST}/scripts/install-runtime.sh" 2>/dev/null || true

### 2) 旧布局清理：runtime/ 下的预置运行时已无意义。
###    ⚠ 只动包内容树（TRIM_APPDEST，升级时本就整体替换），不碰 DATA 里的用户数据。
if [ -d "${RUNTIME}" ]; then
    rm -rf "${RUNTIME}/python" "${RUNTIME}/hermes" "${RUNTIME}/hermes-git.git" \
           "${RUNTIME}/deps.txt" "${RUNTIME}/web-build.mjs" 2>/dev/null || true
    echo "$(date -Is) 已清理旧预置运行时（runtime/python、runtime/hermes 等）" \
        >> "${DATA}/log/upgrade.log" 2>/dev/null || true
fi

### 3) 数据目录里的旧产物：
###    <data>/site-packages 是旧 LAZY_SITE，新布局不再使用 → 归档（不删，可回退）
if [ -d "${DATA}/site-packages" ]; then
    _bak="${DATA}/site-packages.archived-$(date +%Y%m%d%H%M%S)"
    if mv "${DATA}/site-packages" "${_bak}" 2>/dev/null; then
        echo "$(date -Is) 旧 LAZY_SITE 已归档 → ${_bak}" \
            >> "${DATA}/log/upgrade.log" 2>/dev/null || true
    fi
fi

### 3b) 关键：清掉【旧源码路径】对应的 PM 环境。
### pm/environments.py 的 install_key = sha256(源码绝对路径)[:16]。
###   · 旧布局：源码在包内 <appcenter>/runtime/hermes
###   · 新布局：源码在数据目录 <data>/src
### 两者 key 不同 → 升级后 installs/ 下会有【两套】facts.json。
### 我们按 find|head -n1 取环境，可能拿到旧的那套（其 venv 指向已删除的路径）
### → 启动失败。所以把「不是 <data>/src 算出来的 key」的目录全部归档。
IMPORT_STATE="${DATA}/installs"
if [ -d "${IMPORT_STATE}" ]; then
    KEEP_KEY=""
    if command -v python3 > /dev/null 2>&1; then
        KEEP_KEY="$(python3 -c "import hashlib,sys;print(hashlib.sha256(sys.argv[1].encode()).hexdigest()[:16])" "${DATA}/src" 2>/dev/null || true)"
    fi
    if [ -n "${KEEP_KEY}" ]; then
        ARCH_DIR="${IMPORT_STATE}.archived-$(date +%Y%m%d%H%M%S)"
        MOVED=0
        for d in "${IMPORT_STATE}"/*/; do
            [ -d "${d}" ] || continue
            NAME="$(basename "${d%/}")"
            case "${NAME}" in
                *.disabled-*) continue ;;
                "${KEEP_KEY}") continue ;;
            esac
            mkdir -p "${ARCH_DIR}" 2>/dev/null || true
            if mv "${d%/}" "${ARCH_DIR}/${NAME}" 2>/dev/null; then
                MOVED=$((MOVED + 1))
            fi
        done
        if [ "${MOVED}" -gt 0 ]; then
            echo "$(date -Is) 已归档 ${MOVED} 个旧 PM 环境 → ${ARCH_DIR}（保留新 key=${KEEP_KEY}）" \
                >> "${DATA}/log/upgrade.log" 2>/dev/null || true
        fi
    else
        echo "$(date -Is) ⚠ 无法计算新源码的 install key（缺少 python3），跳过旧 PM 环境归档" \
            >> "${DATA}/log/upgrade.log" 2>/dev/null || true
    fi
fi

### 4) 源码/依赖缺失不阻塞升级；真正缺失时 cmd/main 启动会同步补齐。
if [ ! -d "${DATA}/src/hermes_cli" ]; then
    echo "$(date -Is) 尚无 ${DATA}/src —— 首次启动时会自动获取源码与依赖" \
        >> "${DATA}/log/upgrade.log" 2>/dev/null || true
fi

### 5) 属主：只修顶层（全量递归在 168k 条目 / 12GB 上会超时，实机报告 C3）
chown "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${DATA}" 2>/dev/null || true
for d in log workspace state; do
    [ -d "${DATA}/${d}" ] && \
        chown "${TRIM_USERNAME}:${TRIM_GROUPNAME}" "${DATA}/${d}" 2>/dev/null || true
done

echo "$(date -Is) upgrade_callback 完成" >> "${DATA}/log/upgrade.log" 2>/dev/null || true
exit 0
