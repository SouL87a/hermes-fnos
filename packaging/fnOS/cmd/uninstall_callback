#!/bin/bash
# 卸载后回调。
#
# 数据去留由「卸载向导」的 wizard_delete_data 决定（wizard/uninstall）：
#   "true"  → 完全删除：应用私有数据 + 工作区共享目录
#   "false" → 保留（默认）：下次安装可继续使用；升级/重装也走这条
#
# ⚠ 2026-10-24 修复（升级失败 APP_UPDATE_FAILED code=10393 的根因）：
#   ① 原来的 `pgrep -f "/var/apps/${APP}/"` 会匹配到【本脚本自己】——
#      本脚本的 cmdline 就是 `/var/apps/hermes/cmd/uninstall_callback`，
#      于是下面那行 kill -KILL 把脚本自身杀了，退出码变成 137(SIGKILL)。
#      平台把这一步记为 UninstallCallbackException(10393)，
#      而 fnOS 的「覆盖升级」内部会先执行旧版的卸载回调 → 升级必然失败。
#      实测复现：pgrep -f 在脚本内部会列出脚本自身 pid（见 2026-10-24 验证记录）。
#   ② 修法：踢掉自己、父进程、以及祖先进程链，再杀应用进程。
#      另外把匹配收窄为「确实运行在应用目录里的可执行文件」，避免误杀平台自身的
#      rsync/tar/cp（升级时它们的命令行里同样含 /@appcenter/hermes/）。

APP="hermes"

_self_pids() {
    # 自己 + 祖先进程链（平台调用链上都是 hook 脚本，不能杀）
    local p="$$"
    while [ -n "${p}" ] && [ "${p}" -gt 1 ] 2>/dev/null; do
        printf '%s\n' "${p}"
        p="$(awk '{print $4}' "/proc/${p}/stat" 2>/dev/null)"
    done
}

_skip=" $( _self_pids | tr '\n' ' ' ) "

# ① 兜底清进程（只杀真正跑在应用目录里的进程，且排除自身与祖先）。
for pid in $(pgrep -f "/@appcenter/${APP}/" 2>/dev/null; pgrep -f "/var/apps/${APP}/" 2>/dev/null); do
    case "${_skip}" in *" ${pid} "*) continue ;; esac
    # 只处理 exe 落在应用目录里的进程；hook 脚本（bash）与平台复制进程一律跳过。
    _exe="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)"
    case "${_exe}" in
        /vol*/@appcenter/${APP}/*|/var/apps/${APP}/target/*) ;;
        *) continue ;;
    esac
    kill -KILL "${pid}" 2>/dev/null || true
done

# ② 数据清理（按向导选择）。
if [ "${wizard_delete_data:-false}" = "true" ]; then
    # 应用私有数据目录：整删。
    [ -n "${TRIM_PKGVAR}" ] && rm -rf "${TRIM_PKGVAR}" 2>/dev/null || true
    # 工作区共享目录（连同其父 —— 该父是本应用创建的共享点）。只删本应用自己的
    # /@appshare/hermes，绝不碰其它共享。
    for d in /vol*/@appshare/${APP}/workspace /vol*/@appshare/${APP}; do
        [ -d "${d}" ] && rm -rf "${d}" 2>/dev/null || true
    done
    # TRIM_DATA_SHARE_PATHS 里若含该共享路径，也一并尝试。
    if [ -n "${TRIM_DATA_SHARE_PATHS}" ]; then
        _ifs_save="${IFS}"; IFS=':'
        for p in ${TRIM_DATA_SHARE_PATHS}; do
            case "${p}" in */${APP}/workspace|*/${APP}) rm -rf "${p}" 2>/dev/null || true ;; esac
        done
        IFS="${_ifs_save}"
    fi
fi

exit 0
